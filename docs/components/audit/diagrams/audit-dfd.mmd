flowchart LR
  subgraph B1["Trust boundary 1: untrusted client"]
    CLIENT["Browser or API client\nRoute, body, headers and cookies are untrusted"]
  end

  subgraph B2["Trust boundary 2: Platform.Api process"]
    CORR["UseCorrelationContext\nFirst middleware; server-generated correlation ID"]
    SESS["SessionCheckMiddleware\nValidated session; actor is never taken from the client"]
    ACCESS["UseAccessControl\nDefault deny; decision per action"]
    HANDLERS["Business handlers\nIdentity, Review, Administration and others"]
    IDP["IdentityAuditProducer\nLogin, logout, throttled login, account status"]
    FWD["CentralAccessAuditWriter\nWrites denials only; failure is logged, decision unchanged"]
    RELAY["AdministrationAuditRelay\nOperator batch from the ADM-08 outbox; stable event IDs"]
    TXW["PostgresTransactionalAuditWriter\nStatus change, unlock, revision review"]
    CTX["ServerAuditContextProvider\nActor from session, correlation from middleware\nAmbient writer path has no caller yet"]
    WRITER["AuditWriter\nIAuditWriter and ITrustedAuditWriter"]
    VALIDATE["AuditDraftValidator\nEvent catalog, detail allowlist, secret-like keys rejected"]
    DOMAIN["Immutable AuditEvent\nServer event ID and UTC time"]
    STORE["PostgresAuditEventStore\nParameterized append; idempotent event ID"]
    QUERY["CourseAuditQueryService + CourseAuditReadPolicy\nImplemented; not registered, no HTTP endpoint on main"]
    LEGACY["Identity IAuditWriter to LoggerAuditWriter\nApplication log only; no production caller found (D1)"]
  end

  subgraph B3["Trust boundary 3: PostgreSQL"]
    DB[("audit.audit_events\nRuntime role: SELECT, INSERT\nTrigger rejects UPDATE and DELETE")]
    OUTBOX[("coursework_admin.outbox\nADM-08 producer events")]
  end

  subgraph B4["Trust boundary 4: privileged operator"]
    MIG["Migration and bootstrap\ndotnet ef, bootstrap-runtime.sql, separate account"]
  end

  CLIENT -->|"HTTP request"| CORR
  CORR --> SESS
  SESS --> ACCESS
  ACCESS --> HANDLERS
  ACCESS -->|"Deny decision"| FWD
  HANDLERS --> IDP
  HANDLERS -->|"Business change"| TXW
  IDP -->|"Draft + explicit server context"| WRITER
  FWD -->|"Draft + server context"| WRITER
  OUTBOX --> RELAY
  RELAY -->|"Draft + stored actor and correlation"| WRITER
  CTX -.->|"Ambient context; not used by a producer yet"| WRITER
  WRITER --> VALIDATE
  VALIDATE -->|"Rejected: stable code, nothing written"| HANDLERS
  VALIDATE -->|"Accepted"| DOMAIN
  DOMAIN --> STORE
  STORE -->|"Parameterized INSERT"| DB
  STORE -.->|"Unavailable: no internal details returned"| HANDLERS
  TXW -->|"INSERT inside the caller transaction"| DB
  MIG -->|"DDL and grants"| DB
  DB -.->|"Future authorized read only"| QUERY
  QUERY -.->|"audit.events.read per course; not reachable over HTTP"| CLIENT
  HANDLERS -.->|"Registered, not called"| LEGACY

