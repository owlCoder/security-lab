flowchart TD
  CLIENT["Browser or API client"] -->|"HTTPS; real session cookie; DTO"| API["ADM-08 endpoints: explicit central Access metadata"]
  API --> ACCESS["Shared Access middleware and decision engine"]
  ACCESS --> SUBJECT["AdministrationSubjectProvider: validated Identity session"]
  SUBJECT --> IDENTITY["ISessionManager and IAccountStatusReader"]
  ACCESS --> POLICY["PersistentAdministrationPolicy: current scoped grant"]
  API --> SERVICE["PersistentAdministrationService and domain validation"]
  POLICY --> SESSION["PostgresAdministrationSession: fresh reads and serialized writes"]
  SERVICE --> SESSION
  SESSION -->|"Current active account"| IDENTITY
  IDENTITY --> IDDB[("Identity database: accounts and sessions")]
  SESSION --> DB[("coursework_admin: settings, grants, producer outbox")]
  SERVICE -->|"Revalidate real session before commit"| SUBJECT
  OPERATOR["Explicit operator migration tool"] -->|"Schema owner; no HTTP root provisioning"| DB
  DB -.-> PENDING["Central delivery of administrative outbox: pending"]
