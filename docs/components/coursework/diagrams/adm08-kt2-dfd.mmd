flowchart TD
  subgraph CLIENT["Trust boundary 1: untrusted client"]
    ACTOR["Course administrator or delegate"]
    INPUT["Cookie; course/grant IDs; settings or capability DTO"]
    ACTOR --> INPUT
  end
  subgraph API["Trusted API and application"]
    AUTH["P1: validate real session and current account"]
    DECIDE["P2: shared Access and exact-course capability"]
    CHANGE["P3: validate DTO; bind grant/version; perform operation"]
    RECHECK["P4: recheck Identity session before commit"]
    DENY["Normalize rejection; central audit for Access denials"]
    OUT["Public JSON: 200 / 400 / 401 / 404 / 409 / 413 / 503"]
    AUTH --> DECIDE
    DECIDE -->|"Allow"| CHANGE
    AUTH -->|"Invalid session or unavailable Identity"| DENY
    DECIDE -->|"Deny or unavailable authority"| DENY
    CHANGE -->|"Invalid input"| DENY
    CHANGE --> RECHECK
    RECHECK -->|"Invalidated: rollback"| DENY
    RECHECK -->|"Commit success"| OUT
    DENY --> OUT
  end
  subgraph PROVIDERS["Trust boundary 2: provider contracts and databases"]
    ID[("D1: Identity accounts and sessions")]
    ADM[("D2: administrative labels and current grants")]
    EVENTS[("D3: durable producer outbox")]
  end
  INPUT -->|"HTTPS request"| AUTH
  AUTH -->|"Opaque session token"| ID
  ID -->|"Validated subject/current status or failure"| AUTH
  DECIDE -->|"Actor and course"| ADM
  ADM -->|"Current grant/version or absence"| DECIDE
  CHANGE -->|"Bound reads; course lock; compare version"| ADM
  CHANGE -->|"Metadata-only event in same transaction"| EVENTS
  RECHECK --> ID
  ID -->|"Current session status"| RECHECK
  OUT -->|"Permitted metadata or generic denial"| ACTOR
