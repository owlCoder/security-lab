{
  "realm": "security-lab",
  "displayName": "Security Lab (local test IdP)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "security-lab-api",
      "name": "Security Lab API (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/api/auth/oidc/callback",
        "http://localhost:5080/api/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "student",
      "email": "student@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Student",
      "enabled": true,
      "realmRoles": ["default-roles-security-lab"],
      "credentials": [{ "type": "password", "value": "${OIDC_TEST_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "blocked",
      "email": "blocked@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Blocked",
      "enabled": true,
      "realmRoles": ["default-roles-security-lab"],
      "credentials": [{ "type": "password", "value": "${OIDC_TEST_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "fake-teacher",
      "email": "teacher@example.com",
      "emailVerified": false,
      "firstName": "Fake",
      "lastName": "Teacher",
      "enabled": true,
      "realmRoles": ["default-roles-security-lab"],
      "credentials": [{ "type": "password", "value": "${OIDC_TEST_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "stranger",
      "email": "stranger@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Stranger",
      "enabled": true,
      "realmRoles": ["default-roles-security-lab"],
      "credentials": [{ "type": "password", "value": "${OIDC_TEST_USER_PASSWORD}", "temporary": false }]
    }
  ]
}