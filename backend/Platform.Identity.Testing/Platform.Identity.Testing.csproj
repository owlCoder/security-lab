<Project Sdk="Microsoft.NET.Sdk">
  <!-- US-15: test support shared by every test project that calls the API with a session cookie. Not a test project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <ProjectReference Include="../Platform.Api/Platform.Api.csproj" />
  </ItemGroup>
</Project>
