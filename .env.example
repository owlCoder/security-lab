POSTGRES_USER=securitylab_bootstrap
POSTGRES_DB=securitylab
POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# Read by the API and dotnet ef in local development.
ConnectionStrings__Identity=Host=127.0.0.1;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
Seed__DevelopmentPassword=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# Optional SMTP delivery for IDN-10 email confirmation and IDN-13 sign-in alerts.
# Store real credentials in .env or user-secrets; never commit them.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
# Development only; only permits plaintext SMTP to a loopback host.
Email__Smtp__AllowInsecureLocalMailpit=false
Email__Smtp__User=
Email__Smtp__Password=
Email__FromAddress=
Frontend__BaseUrl=http://localhost:5173

# IDN-06: folder of the Data Protection keys that encrypt TOTP secrets. Outside the repository; back it up
# together with the database. The keys in it are not encrypted at rest. Without it the framework default
# location is used, which persists on a developer machine but not in a container without a home directory.
# Identity__DataProtection__KeysPath=/var/lib/securitylab/dataprotection-keys

# Used by the local Audit runtime bootstrap and the API connection below.
AUDIT_RUNTIME_PASSWORD=CHANGE_ME_FOR_LOCAL_AUDIT_RUNTIME
ConnectionStrings__Audit=Host=127.0.0.1;Port=5432;Database=${POSTGRES_DB};Username=securitylab_audit_runtime;Password=${AUDIT_RUNTIME_PASSWORD}

# IDN-08: local Keycloak (docker compose --profile oidc). Development only, never real passwords.
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_FOR_LOCAL_KEYCLOAK
OIDC_TEST_USER_PASSWORD=CHANGE_ME_FOR_LOCAL_OIDC_USERS

# IDN-08: set to true to enable "Sign in with OIDC" (needs the oidc Docker profile).
Oidc__Enabled=false
