POSTGRES_USER=securitylab_bootstrap
POSTGRES_DB=securitylab
POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# Read by the API and dotnet ef in local development.
ConnectionStrings__Identity=Host=127.0.0.1;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
Seed__DevelopmentPassword=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# Optional SMTP delivery for IDN-10 email confirmation and IDN-13 sign-in alerts.
# Store real credentials in .env or user-secrets; never commit them.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__User=
Email__Smtp__Password=
Email__FromAddress=
Frontend__BaseUrl=http://localhost:5173

# Used only by scripts/audit/bootstrap-runtime.sql, not by the current API.
AUDIT_RUNTIME_PASSWORD=CHANGE_ME_FOR_LOCAL_AUDIT_RUNTIME
